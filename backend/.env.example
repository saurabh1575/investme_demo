NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,null

# Local database file. No external database server needed for local use.
DB_FILE=./data/database.json

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Community links. Paste your real invite links here.
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/YOUR_INVITE_CODE
TELEGRAM_COMMUNITY_URL=https://t.me/YOUR_TELEGRAM_GROUP
FOUNDER_GROUP_URL=https://t.me/YOUR_FOUNDER_GROUP
REQUIRE_COMMUNITY_LOGIN=false

# Payments. If blank, backend returns demo checkout# Razorpay Settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI. If blank, backend returns demo AI responses.
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Optional Supabase/Firebase references if you later connect external auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREBASE_PROJECT_ID=
